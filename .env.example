# Copy to .env.local and fill in locally; copy the same keys into Vercel env vars. Never commit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
GEMINI_API_KEY=
# Blank = gemini-2.5-flash-lite
GEMINI_MODEL=
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_BASE_URL=https://api.vaanivoice.ai
# Any long random string; put the same value in Vaani's webhook config (header or ?secret=)
VAANI_WEBHOOK_SECRET=
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=
CAL_COM_API_KEY=
CAL_COM_EVENT_URL=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
HANDOFF_TO_EMAIL=
ESCALATION_TO_EMAIL=
FOUNDER_EMAIL=
# Telegram (optional). Blank token = off. TELEGRAM_MODE=always sends alongside email (default);
# TELEGRAM_MODE=fallback sends only when the email fails. Find the chat id with: npm run telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MODE=always
DASHBOARD_PASSWORD=
CRON_SECRET=
# Production URL, used for links in emails (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically)
APP_URL=
# Blank = any volunteered budget goes to needs_review (R-BUDGET-01)
APPROVED_BUDGET_FLOOR_INR=
# Cost estimates in rupees (labelled "estimate" on the dashboard; blank = shown as unknown)
VAANI_COST_PER_MIN_INR=5.5
GEMINI_COST_PER_1M_INPUT_TOKENS_INR=
GEMINI_COST_PER_1M_OUTPUT_TOKENS_INR=
