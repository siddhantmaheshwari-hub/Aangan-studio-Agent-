{
  "name": "aangan-enquiry-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "replay": "tsx --env-file-if-exists=.env.local scripts/replay-fixtures.ts",
    "db:local": "pglite-server --db=.localdb --port=54329 --max-connections=4",
    "dev:local": "node scripts/with-local-db.mjs next dev --port 3002",
    "migrate:local": "node scripts/with-local-db.mjs npm run migrate",
    "replay:local": "node scripts/with-local-db.mjs npm run replay -- --db",
    "telegram:setup": "tsx --env-file=.env.local scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
